name:                InfluenceLab
version:             0.1.0.0
build-type:          Simple
cabal-version:       >=1.10

library common 
    hs-source-dirs:    backend/lib
    exposed-modules:   Types
    build-depends:     base >=4.7 && <5, containers, aeson
    default-language:  Haskell2010

executable get-scheme
    hs-source-dirs:    backend/src
    main-is:           Scheme.hs
    build-depends:     base >=4.7 && <5, containers, aeson, common
    default-language:  Haskell2010

executable normalise
    hs-source-dirs:    backend/src
    main-is:           Normalise.hs
    build-depends:     base >=4.7 && <5, containers, aeson, common, bytestring
    default-language:  Haskell2010
    
